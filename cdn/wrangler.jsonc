// The storyfm-audio Worker: Bilibili audio from data/audio/, deployed by src/bilibili.js.
{
  "name": "storyfm-audio",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../data/audio",
    "binding": "ASSETS",
    // Every request goes through worker.js, which answers Range requests the assets alone do not.
    "run_worker_first": true
  }
}
