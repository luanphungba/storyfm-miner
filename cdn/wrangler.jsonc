// The storyfm-audio Worker: serves the audio src/cdn.js uploads to the storyfm-audio R2 bucket.
// Deployed by hand (`npx wrangler@4.142.0 deploy` here) only when worker.js changes.
{
  "name": "storyfm-audio",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "storyfm-audio" }]
}
