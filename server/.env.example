# Copy to server/.env and fill in.

# What the player sends as "Bearer <token>". Make one with: openssl rand -base64 32
MINER_TOKEN=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Pages allowed to call the API, comma separated.
ALLOWED_ORIGINS=https://luanphungba.github.io,http://localhost:8080

# Where the server's copy of the collection lives (default: server/data).
# ANKI_DIR=/var/lib/ci-miner
ANKI_DECK=Chinese::Mining

HOST=127.0.0.1
PORT=8787
