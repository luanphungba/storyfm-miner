{
  "id": "BV1HQTs6FEos-p3",
  "title": "【开源】ESP32多功能手表(含复刻教程) P3 [1-1] 原理图讲解",
  "guid": "BV1HQTs6FEos-p3",
  "pubDate": "2026-07-03",
  "duration": 220,
  "audio": {
    "m4a": "https://storyfm-audio.luanphungba.workers.dev/BV1HQTs6FEos-p3.m4a"
  },
  "source": "bilibili",
  "owner": "火禾实验室",
  "link": "https://www.bilibili.com/video/BV1HQTs6FEos/?p=3",
  "engine": "assemblyai",
  "cues": [
    {
      "i": 0,
      "s": 0,
      "start": 0,
      "end": 1.1,
      "text": "我先来讲解一下",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 1,
      "s": 0,
      "start": 1.1,
      "end": 3,
      "text": "这个原理图是怎么画的",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 2,
      "s": 0,
      "start": 3,
      "end": 3.5,
      "text": "主控芯片",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 3,
      "s": 0,
      "start": 3.5,
      "end": 5.48,
      "text": "采用ESP32-S3-R8",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 4,
      "s": 0,
      "start": 5.48,
      "end": 7.3,
      "text": "由于这款芯片没有内置Flash",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 5,
      "s": 1,
      "start": 7.3,
      "end": 10.2,
      "text": "所以需要外接一个W25Q128",
      "speaker": "A",
      "u": 0,
      "role": "storyteller"
    },
    {
      "i": 6,
      "s": 1,
      "start": 10.2,
      "end": 11.76,
      "text": "提供16兆B的外置Flash",
      "speaker": "A",
      "u": 0,
      "role": "storyteller"
    },
    {
      "i": 7,
      "s": 1,
      "start": 11.76,
      "end": 12.8,
      "text": "用于程序的存储",
      "speaker": "A",
      "u": 0,
      "role": "storyteller"
    },
    {
      "i": 8,
      "s": 1,
      "start": 12.8,
      "end": 13.84,
      "text": "主控芯片",
      "speaker": "A",
      "u": 0,
      "role": "storyteller"
    },
    {
      "i": 9,
      "s": 2,
      "start": 13.84,
      "end": 15.82,
      "text": "直接通过GPIO 19和20",
      "speaker": "A",
      "u": 0,
      "role": "storyteller"
    },
    {
      "i": 10,
      "s": 2,
      "start": 15.82,
      "end": 17.74,
      "text": "连接TypeC的UD负和UD正",
      "speaker": "A",
      "u": 0,
      "role": "storyteller"
    },
    {
      "i": 11,
      "s": 2,
      "start": 17.74,
      "end": 18.98,
      "text": "所以这块板子",
      "speaker": "A",
      "u": 0,
      "role": "storyteller"
    },
    {
      "i": 12,
      "s": 2,
      "start": 18.98,
      "end": 21.4,
      "text": "可以直接通过USB下载和通信",
      "speaker": "A",
      "u": 0,
      "role": "storyteller"
    },
    {
      "i": 13,
      "s": 3,
      "start": 21.4,
      "end": 23.28,
      "text": "ESP32-S3的射频引脚",
      "speaker": "A",
      "u": 0,
      "role": "storyteller"
    },
    {
      "i": 14,
      "s": 3,
      "start": 23.28,
      "end": 24.68,
      "text": "通过射频匹配电路",
      "speaker": "A",
      "u": 0,
      "role": "storyteller"
    },
    {
      "i": 15,
      "s": 3,
      "start": 24.68,
      "end": 27.46,
      "text": "连接到这颗2.4G陶瓷贴片天线",
      "speaker": "A",
      "u": 0,
      "role": "storyteller"
    },
    {
      "i": 16,
      "s": 4,
      "start": 27.46,
      "end": 29.46,
      "text": "用于这个项目中的WiFi功能",
      "speaker": "A",
      "u": 0,
      "role": "storyteller"
    },
    {
      "i": 17,
      "s": 4,
      "start": 29.85,
      "end": 31.37,
      "text": "绘制PCB时",
      "speaker": "A",
      "u": 0,
      "role": "storyteller"
    },
    {
      "i": 18,
      "s": 4,
      "start": 31.37,
      "end": 34.11,
      "text": "要保证这部分的电路全都在同一层，",
      "speaker": "A",
      "u": 0,
      "role": "storyteller"
    },
    {
      "i": 19,
      "s": 5,
      "start": 34.11,
      "end": 36.11,
      "text": "不能把天线或者这里的电阻电容",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 20,
      "s": 5,
      "start": 36.11,
      "end": 38.57,
      "text": "放到背面去，也不能跨层走线，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 21,
      "s": 5,
      "start": 38.57,
      "end": 40.41,
      "text": "不然都可能导致通信失败。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 22,
      "s": 6,
      "start": 40.49,
      "end": 42.75,
      "text": "天线下面需要设置禁止铺铜区域。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 23,
      "s": 7,
      "start": 42.75,
      "end": 44.97,
      "text": "回到原理图，这里ESP32的",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 24,
      "s": 7,
      "start": 44.97,
      "end": 47.57,
      "text": "XTAL_P和XTAL_N引脚",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 25,
      "s": 7,
      "start": 47.57,
      "end": 49.85,
      "text": "需要连一颗四十兆赫兹的晶振，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 26,
      "s": 8,
      "start": 49.85,
      "end": 52.81,
      "text": "这是ESP32-S3的主时钟。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 27,
      "s": 9,
      "start": 52.88,
      "end": 54.25,
      "text": "晶振下方也要记得",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 28,
      "s": 9,
      "start": 54.25,
      "end": 55.7,
      "text": "放置禁止铺铜区域。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 29,
      "s": 10,
      "start": 55.86,
      "end": 57.4,
      "text": "另外这里是复位电路，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 30,
      "s": 10,
      "start": 57.4,
      "end": 59.6,
      "text": "给EN引脚接100纳法的电容，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 31,
      "s": 10,
      "start": 59.6,
      "end": 60.95,
      "text": "可以实现上电复位。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 32,
      "s": 11,
      "start": 61.02,
      "end": 62.67,
      "text": "这个按键按下时也会复位。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 33,
      "s": 12,
      "start": 63.04,
      "end": 63.58,
      "text": "Boot引脚",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 34,
      "s": 12,
      "start": 63.58,
      "end": 65.61,
      "text": "是实现强制进入下载模式。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 35,
      "s": 13,
      "start": 65.84,
      "end": 66.62,
      "text": "这个在芯片",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 36,
      "s": 13,
      "start": 66.62,
      "end": 68.21,
      "text": "第一次下载代码前要用到。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 37,
      "s": 14,
      "start": 68.52,
      "end": 69.71,
      "text": "接下来看外设，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 38,
      "s": 14,
      "start": 69.74,
      "end": 72.5,
      "text": "这个工程里有一条系统I方C总线，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 39,
      "s": 15,
      "start": 72.66,
      "end": 74.3,
      "text": "网络名是ESP_SCL",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 40,
      "s": 15,
      "start": 74.3,
      "end": 76.03,
      "text": "和ESP_SDA，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 41,
      "s": 15,
      "start": 76.06,
      "end": 78.79,
      "text": "总线上有4.7千欧上拉电阻，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 42,
      "s": 15,
      "start": 78.91,
      "end": 80.48,
      "text": "拉到3.3伏。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 43,
      "s": 16,
      "start": 80.48,
      "end": 83.16,
      "text": "这条I方C总线挂了四个主要器件。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 44,
      "s": 17,
      "start": 83.28,
      "end": 85.86,
      "text": "第一个是CW二零幺五电量计，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 45,
      "s": 17,
      "start": 86.12,
      "end": 87.77,
      "text": "它连接电池VBAT正，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 46,
      "s": 17,
      "start": 87.9,
      "end": 89.78,
      "text": "通过I方C把电池电压、",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 47,
      "s": 18,
      "start": 89.78,
      "end": 90.78,
      "text": "电量估计等信息",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 48,
      "s": 18,
      "start": 90.78,
      "end": 92.58,
      "text": "反馈给ESP三二S三。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 49,
      "s": 19,
      "start": 92.58,
      "end": 95.56,
      "text": "第二个是QMC五八八三P磁力计，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 50,
      "s": 19,
      "start": 95.56,
      "end": 97.08,
      "text": "用于指南针功能。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 51,
      "s": 20,
      "start": 97.08,
      "end": 99.92,
      "text": "第三个是BMI二七零六轴IMU，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 52,
      "s": 20,
      "start": 99.92,
      "end": 102.06,
      "text": "它可以检测加速度和角速度，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 53,
      "s": 21,
      "start": 102.06,
      "end": 104.5,
      "text": "用于实现本项目中的抬腕亮屏功能。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 54,
      "s": 22,
      "start": 104.5,
      "end": 105.86,
      "text": "它的INT1已经缴接到了",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 55,
      "s": 22,
      "start": 105.86,
      "end": 108.06,
      "text": "ESP三二S三的BMI_INT，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 56,
      "s": 23,
      "start": 108.06,
      "end": 109.92,
      "text": "可以让传感器在有事件时",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 57,
      "s": 23,
      "start": 109.92,
      "end": 111.54,
      "text": "主动唤醒或者通知主控。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 58,
      "s": 24,
      "start": 111.76,
      "end": 112.32,
      "text": "第四个是",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 59,
      "s": 24,
      "start": 112.32,
      "end": 113.26,
      "text": "PCF八五零六三RTC实时时钟。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 60,
      "s": 25,
      "start": 115.18,
      "end": 115.96,
      "text": "它外接",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 61,
      "s": 25,
      "start": 115.96,
      "end": 118.54,
      "text": "三十二点七六八千赫兹的晶振，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 62,
      "s": 25,
      "start": 118.56,
      "end": 120.06,
      "text": "需要直接用电池的",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 63,
      "s": 25,
      "start": 120.06,
      "end": 121.46,
      "text": "VBAT正给它供电，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 64,
      "s": 26,
      "start": 121.74,
      "end": 122.78,
      "text": "用于在系统休眠",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 65,
      "s": 26,
      "start": 122.78,
      "end": 124.24,
      "text": "或者掉电时维持时间。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 66,
      "s": 27,
      "start": 125,
      "end": 126.62,
      "text": "再看显示屏，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 67,
      "s": 27,
      "start": 126.62,
      "end": 129.06,
      "text": "TFT_BLK设为高电平，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 68,
      "s": 27,
      "start": 129.06,
      "end": 131.59,
      "text": "三极管导通，LEDK接地，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 69,
      "s": 27,
      "start": 131.7,
      "end": 133.55,
      "text": "背光打开，屏幕亮起。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 70,
      "s": 28,
      "start": 133.71,
      "end": 135.8,
      "text": "通过调节TFT_BLK引脚",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 71,
      "s": 28,
      "start": 135.8,
      "end": 137.78,
      "text": "输出的PWM波的占空比",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 72,
      "s": 28,
      "start": 137.78,
      "end": 139.22,
      "text": "来调节屏幕亮度。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 73,
      "s": 29,
      "start": 139.22,
      "end": 141.04,
      "text": "最后再来看一下电源部分的电路。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 74,
      "s": 30,
      "start": 141.13,
      "end": 142.6,
      "text": "一共有两种供电方式，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 75,
      "s": 30,
      "start": 142.91,
      "end": 144.17,
      "text": "一种是通过TypeC的",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 76,
      "s": 30,
      "start": 144.17,
      "end": 145.89,
      "text": "VBUS引脚传入五伏电压，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 77,
      "s": 31,
      "start": 146.13,
      "end": 148.53,
      "text": "经过一片LDO降压至三点三伏",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 78,
      "s": 31,
      "start": 148.53,
      "end": 150.15,
      "text": "给主控芯片供电；",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 79,
      "s": 31,
      "start": 150.15,
      "end": 152.07,
      "text": "还可以通过电池给芯片供电。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 80,
      "s": 32,
      "start": 152.15,
      "end": 153.45,
      "text": "电池的VBAT正引脚",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 81,
      "s": 32,
      "start": 153.45,
      "end": 154.82,
      "text": "连接开关机电路，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 82,
      "s": 32,
      "start": 155.01,
      "end": 157.53,
      "text": "当KEY4按下时，栅极电平拉低，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 83,
      "s": 33,
      "start": 157.71,
      "end": 158.89,
      "text": "PMOS管导通，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 84,
      "s": 33,
      "start": 159.01,
      "end": 160.52,
      "text": "VBAT正连接到VBAT，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 85,
      "s": 34,
      "start": 160.53,
      "end": 161.85,
      "text": "VBAT经过降压芯片",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 86,
      "s": 34,
      "start": 161.85,
      "end": 163.72,
      "text": "输入三V三给主控芯片供电。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 87,
      "s": 35,
      "start": 163.85,
      "end": 166.09,
      "text": "程序初始化拉高CTL引脚，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 88,
      "s": 35,
      "start": 166.09,
      "end": 167.31,
      "text": "这个三极管导通。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 89,
      "s": 36,
      "start": 167.53,
      "end": 169.81,
      "text": "PMOS管的栅极保持低电平，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 90,
      "s": 36,
      "start": 169.81,
      "end": 172.1,
      "text": "VBAT正就能持续给电路供电了。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 91,
      "s": 37,
      "start": 172.21,
      "end": 173.13,
      "text": "这样就实现了在",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 92,
      "s": 37,
      "start": 173.13,
      "end": 175.45,
      "text": "只有电池供电的情况下的开机功能。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 93,
      "s": 38,
      "start": 175.53,
      "end": 176.45,
      "text": "如果想要关机，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 94,
      "s": 38,
      "start": 176.45,
      "end": 178.41,
      "text": "只需要检测KEY4按键是否长按，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 95,
      "s": 38,
      "start": 178.41,
      "end": 179.25,
      "text": "如果长按，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 96,
      "s": 38,
      "start": 179.25,
      "end": 181.8,
      "text": "则主控芯片拉低CTL电平，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 97,
      "s": 39,
      "start": 181.87,
      "end": 183.05,
      "text": "手表就关机了。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 98,
      "s": 40,
      "start": 183.05,
      "end": 184.95,
      "text": "最后我用一颗TP4056芯片",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 99,
      "s": 40,
      "start": 184.95,
      "end": 186.49,
      "text": "对电池进行充电管理。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 100,
      "s": 41,
      "start": 186.49,
      "end": 188.43,
      "text": "当R十七为十千欧时，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 101,
      "s": 41,
      "start": 188.43,
      "end": 190.21,
      "text": "充电电流大致为一百毫安。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 102,
      "s": 42,
      "start": 190.21,
      "end": 192.45,
      "text": "当电池处于充电状态时，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 103,
      "s": 42,
      "start": 192.45,
      "end": 194.01,
      "text": "CHRG引脚会拉低。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 104,
      "s": 43,
      "start": 194.14,
      "end": 195.2,
      "text": "单片机的IO三十六",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 105,
      "s": 43,
      "start": 195.2,
      "end": 196.42,
      "text": "会读取到低电平，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 106,
      "s": 43,
      "start": 196.42,
      "end": 198.43,
      "text": "然后在屏幕上显示充电状态。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 107,
      "s": 44,
      "start": 198.58,
      "end": 200.98,
      "text": "PCB采用四层板双面布局结构，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 108,
      "s": 44,
      "start": 200.98,
      "end": 202.82,
      "text": "板子大小是三十乘三十毫米。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 109,
      "s": 45,
      "start": 202.82,
      "end": 204.2,
      "text": "我把大部分体积小的元器件",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 110,
      "s": 45,
      "start": 204.2,
      "end": 206.6,
      "text": "都放在顶层，方便大家用焊台焊接；",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 111,
      "s": 46,
      "start": 206.6,
      "end": 207.56,
      "text": "底层的元器件",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 112,
      "s": 46,
      "start": 207.56,
      "end": 209.84,
      "text": "只能用电烙铁或者热风枪焊接了。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 113,
      "s": 47,
      "start": 209.86,
      "end": 210.94,
      "text": "元器件还是比较多的，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 114,
      "s": 47,
      "start": 210.94,
      "end": 211.96,
      "text": "所以布局很关键，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 115,
      "s": 47,
      "start": 211.96,
      "end": 213.28,
      "text": "要根据布局灵活改变",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 116,
      "s": 47,
      "start": 213.28,
      "end": 214.89,
      "text": "外设与单片机通信引脚。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 117,
      "s": 48,
      "start": 214.96,
      "end": 217.6,
      "text": "以上就是这块板子大致设计思路。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 118,
      "s": 49,
      "start": 217.6,
      "end": 219.82,
      "text": "下面我们进行PCB和元器件下单。",
      "speaker": "A",
      "role": "storyteller"
    }
  ]
}
