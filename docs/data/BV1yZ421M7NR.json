      "i": 99,
      "s": 45,
      "start": 352.8,
      "end": 355.36,
      "text": "这是一个开源的MQTTBroker，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 100,
      "s": 46,
      "start": 355.74,
      "end": 358.38,
      "text": "学习过MQTT的朋友应该不陌生。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 101,
      "s": 47,
      "start": 358.6,
      "end": 359.9,
      "text": "接下来我们要安装",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 102,
      "s": 47,
      "start": 359.9,
      "end": 361.84,
      "text": "用于绑定智能家居的插件。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 103,
      "s": 48,
      "start": 366.28,
      "end": 368.94,
      "text": "首先，我们在终端输入这行指令",
      "speaker": "B",
      "role": "storyteller"
    },
    {
