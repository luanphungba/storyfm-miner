      "s": 50,
      "start": 377.86,
      "end": 379.59,
      "text": "控制米家设备，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 109,
      "s": 50,
      "start": 379.68,
      "end": 381.84,
      "text": "可以下载小米米LTAuto。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 110,
      "s": 51,
      "start": 384.38,
      "end": 386.96,
      "text": "这里还有很多其他生态的插件，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 111,
      "s": 51,
      "start": 386.96,
      "end": 389.67,
      "text": "比如说Haier。格力，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 112,
      "s": 52,
      "start": 390.16,
      "end": 393.15,
      "text": "下面我会展示如何绑定米家的设备。",
