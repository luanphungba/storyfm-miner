      "role": "narrator"
    },
    {
      "i": 1,
      "s": 1,
      "start": 6.64,
      "end": 8.02,
      "text": "打开空气净化器。",
      "speaker": "A",
      "role": "narrator"
    },
    {
      "i": 2,
      "s": 2,
      "start": 17.49,
      "end": 19.34,
      "text": "嗨，乐鑫！",
      "speaker": "A",
      "role": "narrator"
    },
    {
      "i": 3,
      "s": 3,
      "start": 19.7,
      "end": 21.31,
      "text": "关闭空气净化器。",
      "speaker": "A",
      "role": "narrator"
    },
    {
      "i": 4,
      "s": 4,
      "start": 24.92,
      "end": 25.9,
      "text": "打开台灯。",
      "speaker": "A",
      "role": "narrator"
    },
    {
      "i": 5,
      "s": 5,
      "start": 27.42,
      "end": 29.05,
      "text": "打开灯带。",
      "speaker": "A",
      "role": "narrator"
    },
    {
      "i": 6,
      "s": 6,
      "start": 29.94,
      "end": 29.98,
      "text": "台灯调暗。",
      "speaker": "A",
      "role": "narrator"
    },
    {
      "i": 7,
      "s": 7,
      "start": 33.24,
      "end": 38.18,
      "text": "台灯调亮，关闭台灯，",
      "speaker": "A",
      "role": "narrator"
    },
    {
      "i": 8,
      "s": 7,
      "start": 39.6,
      "end": 43.78,
      "text": "关闭灯带，打开日历，",
      "speaker": "A",
      "role": "narrator"
    },
    {
      "i": 9,
      "s": 7,
      "start": 45.68,
      "end": 49.96,
      "text": "打开时间，播放音乐。",
      "speaker": "A",
      "role": "narrator"
    },
    {
      "i": 10,
      "s": 8,
      "start": 77.26,
      "end": 80.85,
      "text": "嗨，乐鑫。",
      "speaker": "A",
      "role": "narrator"
    },
    {
      "i": 11,
      "s": 9,
      "start": 102.79,
      "end": 104.85,
      "text": "工程源码和3D建模",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 12,
      "s": 9,
      "start": 104.85,
      "end": 106.83,
      "text": "开源在GitHub上了，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 13,
      "s": 9,
      "start": 106.83,
      "end": 108.05,
      "text": "欢迎大家参考。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 14,
      "s": 10,
      "start": 108.89,
      "end": 110.69,
      "text": "控制这些设备原理是什么？",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 15,
      "s": 11,
      "start": 110.69,
      "end": 112.63,
      "text": "我们只需要在HomeAssistant上",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 16,
      "s": 11,
      "start": 112.63,
      "end": 113.83,
      "text": "绑定对应的设备。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 17,
      "s": 12,
      "start": 113.89,
      "end": 117.31,
      "text": "然后使用ESP32S3通过MQTT",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 18,
      "s": 12,
      "start": 117.31,
      "end": 119.49,
      "text": "向HomeAssistant发送消息",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 19,
      "s": 12,
      "start": 119.49,
      "end": 121.65,
      "text": "就可以实现对智能家居的控制",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 20,
      "s": 13,
      "start": 121.65,
      "end": 123.23,
      "text": "那么问题来了",
      "speaker": "B",
      "u": 12,
      "role": "storyteller"
    },
    {
      "i": 21,
      "s": 13,
      "start": 123.23,
      "end": 124.57,
      "text": "什么是HomeAssistant",
      "speaker": "B",
      "u": 12,
      "role": "storyteller"
    },
    {
      "i": 22,
      "s": 13,
      "start": 124.57,
      "end": 126.49,
      "text": "智能家居市场上",
      "speaker": "B",
      "u": 12,
      "role": "storyteller"
    },
    {
      "i": 23,
      "s": 13,
      "start": 126.49,
      "end": 127.93,
      "text": "存在许多家居生态",
      "speaker": "B",
      "u": 12,
      "role": "storyteller"
    },
    {
      "i": 24,
      "s": 13,
      "start": 127.93,
      "end": 130.23,
      "text": "如米家、天猫、HomeKit",
      "speaker": "B",
      "u": 12,
      "role": "storyteller"
    },
    {
      "i": 25,
      "s": 14,
      "start": 130.23,
      "end": 132.61,
      "text": "不同生态之间并不互通",
      "speaker": "B",
      "u": 12,
      "role": "storyteller"
    },
    {
      "i": 26,
      "s": 14,
      "start": 132.61,
      "end": 134.45,
      "text": "购买不同品牌的产品",
      "speaker": "B",
      "u": 12,
      "role": "storyteller"
    },
    {
      "i": 27,
      "s": 14,
      "start": 134.45,
      "end": 136.73,
      "text": "无法集成到一起进行控制",
      "speaker": "B",
      "u": 12,
      "role": "storyteller"
    },
    {
      "i": 28,
      "s": 14,
      "start": 136.73,
      "end": 138.97,
      "text": "不方便协调统一管理",
      "speaker": "B",
      "u": 12,
      "role": "storyteller"
    },
    {
      "i": 29,
      "s": 15,
      "start": 138.97,
      "end": 141.21,
      "text": "HomeAssistant是一款开源的",
      "speaker": "B",
      "u": 12,
      "role": "storyteller"
    },
    {
      "i": 30,
      "s": 15,
      "start": 141.21,
      "end": 143.21,
      "text": "家庭自动化控制管理平台",
      "speaker": "B",
      "u": 12,
      "role": "storyteller"
    },
    {
      "i": 31,
      "s": 15,
      "start": 143.47,
      "end": 146.52,
      "text": "用户可以绑定各个品牌的物联网设备，",
      "speaker": "B",
      "u": 12,
      "role": "storyteller"
    },
    {
      "i": 32,
      "s": 16,
      "start": 146.73,
      "end": 148.73,
      "text": "编写自动化规则和脚本，",
      "speaker": "B",
      "u": 12,
      "role": "storyteller"
    },
    {
      "i": 33,
      "s": 16,
      "start": 148.99,
      "end": 150.45,
      "text": "根据设备状态、时间、",
      "speaker": "B",
      "u": 12,
      "role": "storyteller"
    },
    {
      "i": 34,
      "s": 17,
      "start": 150.45,
      "end": 152.74,
      "text": "传感器数据等触发特定动作。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 35,
      "s": 18,
      "start": 153.29,
      "end": 155.19,
      "text": "这样的话，我们配置好HomeAssistant",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 36,
      "s": 18,
      "start": 155.19,
      "end": 157.01,
      "text": "就可以通过一个控制面板",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 37,
      "s": 18,
      "start": 157.01,
      "end": 159.6,
      "text": "来控制多个平台的智能家居产品。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 38,
      "s": 20,
      "start": 159.61,
      "end": 160.79,
      "text": "接下来我会讲解",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 39,
      "s": 20,
      "start": 160.79,
      "end": 162.31,
      "text": "如何部署HomeAssistant",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 40,
      "s": 20,
      "start": 162.31,
      "end": 164.81,
      "text": "以及如何控制智能家居。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 41,
      "s": 21,
      "start": 167.43,
      "end": 169.45,
      "text": "我们在官网上可以看到。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 42,
      "s": 22,
      "start": 169.66,
      "end": 170.86,
      "text": "HomeAssistantOS",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 43,
      "s": 22,
      "start": 170.92,
      "end": 173.84,
      "text": "在Linux、MacOS、Windows上",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 44,
      "s": 23,
      "start": 173.84,
      "end": 175.46,
      "text": "都可以完成部署，",
      "speaker": "B",
      "u": 22,
      "role": "storyteller"
    },
    {
      "i": 45,
      "s": 23,
      "start": 175.58,
      "end": 178.88,
      "text": "但是在树莓派上部署最方便简单。",
      "speaker": "B",
      "u": 22,
      "role": "storyteller"
    },
    {
      "i": 46,
      "s": 24,
      "start": 179.14,
      "end": 181.2,
      "text": "我们根据这里的提示，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 47,
      "s": 24,
      "start": 181.2,
      "end": 184.5,
      "text": "准备好树莓派、电源线、SD卡和网线，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 48,
      "s": 24,
      "start": 184.5,
      "end": 186.72,
      "text": "点击进入这个教程，跟着步骤走。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 49,
      "s": 25,
      "start": 189.66,
      "end": 190.7,
      "text": "点击这个链接",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 50,
      "s": 25,
      "start": 190.7,
      "end": 193.36,
      "text": "下载树莓派镜像烧录器，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 51,
      "s": 25,
      "start": 193.56,
      "end": 195.74,
      "text": "下载完成后通过读卡器",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 52,
      "s": 25,
      "start": 195.74,
      "end": 197.6,
      "text": "将SD卡连接到电脑。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 53,
      "s": 26,
      "start": 197.87,
      "end": 200.39,
      "text": "打开树莓派镜像烧录器，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 54,
      "s": 26,
      "start": 201.02,
      "end": 203.05,
      "text": "选择对应的树莓派版本，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 55,
      "s": 27,
      "start": 204.9,
      "end": 207.18,
      "text": "选择HomeAssistant操作系统，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 56,
      "s": 27,
      "start": 214.44,
      "end": 221.35,
      "text": "选择SD卡，点击Next开始写入。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 57,
      "s": 28,
      "start": 229.32,
      "end": 231.86,
      "text": "我们可以通过以太网线联网，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 58,
      "s": 28,
      "start": 232.03,
      "end": 233.9,
      "text": "这个是最稳妥的方式。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 59,
      "s": 29,
      "start": 234.13,
      "end": 235.75,
      "text": "也可以在HomeAssistant",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 60,
      "s": 29,
      "start": 235.75,
      "end": 237.67,
      "text": "启动后手动联网。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 61,
      "s": 30,
      "start": 237.67,
      "end": 239.29,
      "text": "如果没有以太网线，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 62,
      "s": 30,
      "start": 239.29,
      "end": 240.91,
      "text": "也可以通过配置文件",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 63,
      "s": 30,
      "start": 240.91,
      "end": 242.07,
      "text": "连接到WiFi。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 64,
      "s": 31,
      "start": 242.19,
      "end": 244.17,
      "text": "我们打开SD卡，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 65,
      "s": 31,
      "start": 244.17,
      "end": 246.41,
      "text": "创建一个config文件夹，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 66,
      "s": 31,
      "start": 248.01,
      "end": 251.11,
      "text": "在文件夹里创建一个network文件夹。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 67,
      "s": 32,
      "start": 252.89,
      "end": 254.63,
      "text": "然后在文件夹里",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 68,
      "s": 32,
      "start": 254.63,
      "end": 257.03,
      "text": "创建一个mynetwork文件，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 69,
      "s": 32,
      "start": 258.79,
      "end": 261.71,
      "text": "把配置信息保存在这里。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 70,
      "s": 33,
      "start": 261.71,
      "end": 264.91,
      "text": "可以去我的Git上复制文本，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 71,
      "s": 33,
      "start": 275.05,
      "end": 276.95,
      "text": "将SD卡插入树莓派。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 72,
      "s": 34,
      "start": 277.75,
      "end": 281.36,
      "text": "然后接上以太网线和电源，我们要确保",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 73,
      "s": 34,
      "start": 281.36,
      "end": 284.42,
      "text": "树莓派和电脑处于同一局域网下，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 74,
      "s": 34,
      "start": 284.42,
      "end": 285.89,
      "text": "并且连接到互联网。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 75,
      "s": 35,
      "start": 286.42,
      "end": 288.02,
      "text": "如果想监视启动过程，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 76,
      "s": 35,
      "start": 288.02,
      "end": 290.96,
      "text": "可以通过HDMI线接入屏幕，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 77,
      "s": 35,
      "start": 290.96,
      "end": 293.26,
      "text": "但一般情况下我们不需要。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 78,
      "s": 36,
      "start": 293.68,
      "end": 295.24,
      "text": "系统初始化完成后，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 79,
      "s": 36,
      "start": 295.24,
      "end": 297.6,
      "text": "我们在浏览器中打开网页，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 80,
      "s": 36,
      "start": 297.6,
      "end": 299.68,
      "text": "可以看到这个准备页面。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 81,
      "s": 37,
      "start": 299.78,
      "end": 302.04,
      "text": "我们耐心等待二十分钟，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 82,
      "s": 37,
      "start": 302.44,
      "end": 305.38,
      "text": "准备完成之后就可以看到这个页面。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 83,
      "s": 38,
      "start": 305.44,
      "end": 307.16,
      "text": "我们点击创建我的智能家居。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 84,
      "s": 39,
      "start": 308.14,
      "end": 310.95,
      "text": "然后设置用户名和密码，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 85,
      "s": 39,
      "start": 310.95,
      "end": 312.61,
      "text": "还有这个是地址，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 86,
      "s": 39,
      "start": 312.61,
      "end": 313.63,
      "text": "系统会根据地址",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 87,
      "s": 39,
      "start": 313.63,
      "end": 316.56,
      "text": "来设置时区、单位、天气信息等配置。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 88,
      "s": 40,
      "start": 316.87,
      "end": 317.97,
      "text": "配置完成后，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 89,
      "s": 40,
      "start": 317.97,
      "end": 320.87,
      "text": "我们就可以使用HomeAssistant系统了。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 90,
      "s": 41,
      "start": 320.99,
      "end": 324.03,
      "text": "不过想通过MQTT控制智能家居，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 91,
      "s": 41,
      "start": 324.03,
      "end": 326.61,
      "text": "我们还需要给系统安装一些插件。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 92,
      "s": 42,
      "start": 331.51,
      "end": 334.93,
      "text": "点击界面左下角配置，进入加载项。",
