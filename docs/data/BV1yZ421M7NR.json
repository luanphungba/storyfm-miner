      "s": 43,
      "start": 339.94,
      "end": 341.99,
      "text": "这里我们要下载两个加载项，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 95,
      "s": 43,
      "start": 342.38,
      "end": 343.75,
      "text": "一个是网页终端，",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 96,
      "s": 44,
      "start": 344.02,
      "end": 344.86,
      "text": "这样我们就可以",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 97,
      "s": 44,
      "start": 344.86,
      "end": 347.46,
      "text": "直接在网页上使用终端指令了。",
      "speaker": "B",
      "role": "storyteller"
    },
    {
      "i": 98,
      "s": 45,
      "start": 350.72,
      "end": 352.56,
      "text": "另一个是MosquittoBroker，",
      "speaker": "B",
      "role": "storyteller"
    },
