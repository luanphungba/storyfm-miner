  "source": "podcast",
  "owner": "瞎扯学中文 Convo Chinese",
  "link": "https://open.firstory.fm/story/ckp4f8dgvt1lr087586ckd9km",
  "engine": "assemblyai",
  "cues": [
    {
      "i": 0,
      "s": 0,
      "start": 6.62,
      "end": 8.12,
      "text": "Hello，大家好，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 1,
      "s": 0,
      "start": 8.12,
      "end": 12.19,
      "text": "欢迎大家来收听我们的第五期节目。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 2,
      "s": 1,
      "start": 12.64,
      "end": 16.44,
      "text": "那不知不觉已经录了五期节目了。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 3,
      "s": 2,
      "start": 16.44,
      "end": 18.22,
      "text": "一开始做的时候呢，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 4,
      "s": 2,
      "start": 18.22,
      "end": 22.44,
      "text": "我也没有想到我能不能坚持下来，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 5,
      "s": 2,
      "start": 22.44,
      "end": 24.28,
      "text": "没有想到做着做着",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 6,
      "s": 2,
      "start": 24.28,
      "end": 26.2,
      "text": "就已经第五个星期了。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 7,
      "s": 3,
      "start": 26.9,
      "end": 30.4,
      "text": "今天呢，我没有请到我的好朋友",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 8,
      "s": 3,
      "start": 30.4,
      "end": 35.08,
      "text": "或者是特邀嘉宾来跟我一起聊，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 9,
      "s": 3,
      "start": 35.3,
      "end": 37.96,
      "text": "因为这个星期我有一点忙，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 10,
      "s": 4,
      "start": 38,
      "end": 40.16,
      "text": "然后我也有一点累。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 11,
      "s": 5,
      "start": 40.42,
      "end": 45.02,
      "text": "上周末呢是法国的一个国定节假日，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 12,
      "s": 5,
      "start": 45.06,
      "end": 48.28,
      "text": "所以说周一的我们不用上课，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 13,
      "s": 6,
      "start": 48.28,
      "end": 50.3,
      "text": "我呢就和几个小伙伴",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 14,
      "s": 6,
      "start": 50.3,
      "end": 54.3,
      "text": "一起自驾开车去了比利时。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 15,
      "s": 7,
      "start": 54.66,
      "end": 57.34,
      "text": "比利时的首都布鲁塞尔，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 16,
      "s": 7,
      "start": 57.34,
      "end": 60.98,
      "text": "我们做了一个三天的自驾游，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 17,
      "s": 7,
      "start": 61,
      "end": 62.72,
      "text": "所以呢，我昨天刚刚回来，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 18,
      "s": 7,
      "start": 62.82,
      "end": 64.38,
      "text": "感觉有一点累。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 19,
      "s": 8,
      "start": 64.84,
      "end": 67.48,
      "text": "这周我就没有安排和我的朋友",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 20,
      "s": 8,
      "start": 67.48,
      "end": 70.52,
      "text": "或者任何嘉宾来录这个节目，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 21,
      "s": 8,
      "start": 70.6,
      "end": 72.78,
      "text": "但是呢，我又想，呃，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 22,
      "s": 9,
      "start": 72.78,
      "end": 74.93,
      "text": "每周我们都会更新一次，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 23,
      "s": 9,
      "start": 75.08,
      "end": 78.94,
      "text": "所以不能够放弃这个光荣传统，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 24,
      "s": 9,
      "start": 78.94,
      "end": 81.12,
      "text": "所以今天我就偷一个懒。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 25,
      "s": 10,
      "start": 81.42,
      "end": 84.74,
      "text": "自己一个人录一小段独白，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 26,
      "s": 10,
      "start": 84.74,
      "end": 88.78,
      "text": "也算是交代一下这这个星期的任务。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 27,
      "s": 11,
      "start": 88.78,
      "end": 93.14,
      "text": "然后呢，下个星期我有打算邀请到",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 28,
      "s": 11,
      "start": 93.14,
      "end": 96.58,
      "text": "我一位学中文的法国好朋友，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 29,
      "s": 12,
      "start": 96.86,
      "end": 97.9,
      "text": "他的中文说的",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 30,
      "s": 12,
      "start": 97.9,
      "end": 100.52,
      "text": "真的是特别特别的流利，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 31,
      "s": 12,
      "start": 100.52,
      "end": 103.58,
      "text": "是我认识的所有外国人当中",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 32,
      "s": 12,
      "start": 103.58,
      "end": 106.1,
      "text": "学中文说的最流利的，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 33,
      "s": 13,
      "start": 106.1,
      "end": 108.38,
      "text": "所以我希望能够请到他",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 34,
      "s": 13,
      "start": 108.38,
      "end": 110.42,
      "text": "来跟大家分享一下。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 35,
      "s": 14,
      "start": 110.49,
      "end": 113.27,
      "text": "他在学中文的过程当中",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 36,
      "s": 14,
      "start": 113.27,
      "end": 116.4,
      "text": "有什么心得啊、心路历程，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 37,
      "s": 14,
      "start": 116.57,
      "end": 119.39,
      "text": "以及他可以给大大家",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 38,
      "s": 14,
      "start": 119.39,
      "end": 121.92,
      "text": "一些学中文的建议等等。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 39,
      "s": 15,
      "start": 122.55,
      "end": 126.11,
      "text": "第二点呢，今天我其实有看到",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 40,
      "s": 15,
      "start": 126.11,
      "end": 130.03,
      "text": "我的节目已经在各个不同的平台上，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 41,
      "s": 15,
      "start": 130.03,
      "end": 131.69,
      "text": "比如说Spotify呀、",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 42,
      "s": 16,
      "start": 131.69,
      "end": 132.65,
      "text": "Google Podcast，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 43,
      "s": 16,
      "start": 132.91,
      "end": 136.75,
      "text": "可能有二十几个到三十几个听众。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 44,
      "s": 17,
      "start": 136.8,
      "end": 138.29,
      "text": "我的follower，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 45,
      "s": 17,
      "start": 138.32,
      "end": 140.48,
      "text": "我觉得特别开心，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 46,
      "s": 17,
      "start": 140.48,
      "end": 143.25,
      "text": "因为在刚开始做这个节目的时候，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 47,
      "s": 18,
      "start": 143.48,
      "end": 145.58,
      "text": "我想可能只是为了",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 48,
      "s": 18,
      "start": 145.58,
      "end": 148.22,
      "text": "我自己的周围的好朋友，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 49,
      "s": 18,
      "start": 148.22,
      "end": 152.64,
      "text": "那些学中文的外国的好朋友们来听、",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 50,
      "s": 19,
      "start": 152.64,
      "end": 154.12,
      "text": "来用我的这个podcast",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 51,
      "s": 19,
      "start": 154.12,
      "end": 155.49,
      "text": "学习中文。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 52,
      "s": 20,
      "start": 155.56,
      "end": 157.86,
      "text": "没有想到现在我看到",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 53,
      "s": 20,
      "start": 157.86,
      "end": 159.74,
      "text": "来自世界各地",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 54,
      "s": 20,
      "start": 159.74,
      "end": 162.1,
      "text": "有很多不同国家的听众。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 55,
      "s": 21,
      "start": 162.33,
      "end": 164.31,
      "text": "正在收听我的节目，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 56,
      "s": 21,
      "start": 164.38,
      "end": 167.79,
      "text": "我真的觉得很开心，然后很感动。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 57,
      "s": 22,
      "start": 168.05,
      "end": 168.77,
      "text": "比如我看到",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 58,
      "s": 22,
      "start": 168.77,
      "end": 171.86,
      "text": "有很多东南亚国家的听众，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 59,
      "s": 22,
      "start": 171.93,
      "end": 176.06,
      "text": "有来自越南呀、马来西亚、印度尼西亚，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 60,
      "s": 23,
      "start": 176.13,
      "end": 178.03,
      "text": "也有很多欧洲的、",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 61,
      "s": 23,
      "start": 178.03,
      "end": 180.08,
      "text": "美国的、加拿大的朋友。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 62,
      "s": 24,
      "start": 180.39,
      "end": 184.37,
      "text": "虽然一共就二十几个、三十几个听众，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 63,
      "s": 24,
      "start": 184.37,
      "end": 186.97,
      "text": "但我还是觉得很开心。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 64,
      "s": 25,
      "start": 186.97,
      "end": 191.04,
      "text": "所以首先要谢谢你们。听我的节目，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 65,
      "s": 26,
      "start": 191.14,
      "end": 193.29,
      "text": "其次呢？其次呢？",
      "speaker": "A",
      "u": 25,
      "role": "storyteller"
    },
    {
      "i": 66,
      "s": 28,
      "start": 193.29,
      "end": 197.79,
      "text": "我其实也很希望可以可以认识大家。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 67,
      "s": 29,
      "start": 197.79,
      "end": 200.61,
      "text": "所以说，你们如果对我的节目",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 68,
      "s": 29,
      "start": 200.61,
      "end": 204.25,
      "text": "有什么建议呀，有什么期待，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 69,
      "s": 29,
      "start": 204.25,
      "end": 207.59,
      "text": "或者是有什么你们感兴趣的话题，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 70,
      "s": 30,
      "start": 207.97,
      "end": 211.89,
      "text": "甚至呢，你们也可以简单的介绍一下",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 71,
      "s": 30,
      "start": 211.89,
      "end": 213.87,
      "text": "你们为什么要学中文，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 72,
      "s": 30,
      "start": 213.87,
      "end": 215.65,
      "text": "学中文多长时间了。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 73,
      "s": 31,
      "start": 215.91,
      "end": 219.55,
      "text": "以及你们在学习中文的过程当中，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 74,
      "s": 31,
      "start": 219.55,
      "end": 222.64,
      "text": "觉得最大的困难、最大的挑战是什么？",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 75,
      "s": 32,
      "start": 222.71,
      "end": 224.31,
      "text": "都可以在这个Podcast",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 76,
      "s": 32,
      "start": 224.31,
      "end": 226.57,
      "text": "下面的留言区留言。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 77,
      "s": 33,
      "start": 226.87,
      "end": 228.53,
      "text": "我非常非常的希望",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 78,
      "s": 33,
      "start": 228.53,
      "end": 231.31,
      "text": "能够收到大家的留言，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 79,
      "s": 33,
      "start": 231.31,
      "end": 233.49,
      "text": "希望能够跟大家交一个朋友。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 80,
      "s": 34,
      "start": 234.89,
      "end": 237.15,
      "text": "好呀，那今天就让我偷个懒，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 81,
      "s": 34,
      "start": 237.15,
      "end": 238.45,
      "text": "就说到这里吧。",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 82,
      "s": 35,
      "start": 238.67,
      "end": 241.15,
      "text": "我们下期节目再见喽！",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 83,
      "s": 36,
      "start": 241.31,
      "end": 244.27,
      "text": "祝大家这个星期。工作愉快，",
      "speaker": "A",
      "role": "storyteller"
    },
    {
      "i": 84,
      "s": 37,
      "start": 244.27,
      "end": 246.19,
      "text": "生活愉快，学习顺利。",
      "speaker": "A",
      "u": 36,
      "role": "storyteller"
    }
  ]
}
