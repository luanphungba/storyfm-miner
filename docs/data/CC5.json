{
  "id": "CC5",
  "title": "EPISODE 5 | 偷个小懒  Being lazy....",
  "guid": "ckp4f8dgvt1lr087586ckd9km",
  "pubDate": "2021-05-25",
  "duration": 253,
  "audio": {
    "m4a": "https://storyfm-audio.luanphungba.workers.dev/CC5.m4a"
